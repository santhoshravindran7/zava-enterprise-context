    {
      "id": "FAB-OPERATIONS",
      "proposed_name": "Zava Operations",
      "native_id": null,
      "status": "NOT_RUN",
      "implementation": "MANUAL_IMPORT_CONTRACT",
      "fact_table": "Operations",
      "file": "fabric/operations.csv",
      "grain": "AccountKey, Date, Segment",
      "dimensions": {
        "Account": "fabric/accounts.csv",
        "Calendar": "fabric/calendar.csv",
        "Segments": "fabric/segments.csv"
      },
      "relationships": [
        {
          "from": "Operations.AccountKey",
          "to": "Account.AccountKey",
          "cardinality": "many-to-one",
          "filter_direction": "dimension-to-fact",
          "active": true
        },
        {
          "from": "Operations.Date",
          "to": "Calendar.Date",
          "cardinality": "many-to-one",
          "filter_direction": "dimension-to-fact",
          "active": true
        },
        {
          "from": "Operations.Segment",
          "to": "Segments.Segment",
          "cardinality": "many-to-one",
          "filter_direction": "dimension-to-fact",
          "active": true
        }
      ],
      "types": {
        "Date": "Date",
        "PeriodKey": "Int64",
        "money_columns": "Int64 USD",
        "count_columns": "Int64",
        "other_columns": "Text"
      },
      "hide": "Fact money/count columns, foreign keys; expose explicit measures and dimensions.",
      "measures": [
        {
          "name": "Eligible Orders",
          "expression": "SUM(Operations[EligibleOrders])",
          "format": "#,0",
          "description": "Synthetic Operations measure: Eligible Orders. Preserve account and period filters."
        },
        {
          "name": "OTIF Orders",
          "expression": "SUM(Operations[OTIFOrders])",
          "format": "#,0",
          "description": "Synthetic Operations measure: OTIF Orders. Preserve account and period filters."
        },
        {
          "name": "OTIF",
          "expression": "DIVIDE([OTIF Orders], [Eligible Orders])",
          "format": "0.00%",
          "description": "Synthetic Operations measure: OTIF. Preserve account and period filters."
        },
        {
          "name": "Operational Freight",
          "expression": "SUM(Operations[FreightUSD])",
          "format": "$#,0;($#,0);$0",
          "description": "Synthetic Operations measure: Operational Freight. Preserve account and period filters."
        },
        {
          "name": "Expedited Freight Subset",
          "expression": "SUM(Operations[ExpeditedFreightUSD])",
          "format": "$#,0;($#,0);$0",
          "description": "Synthetic Operations measure: Expedited Freight Subset. Preserve account and period filters."
        }
      ]
    }
  ],
  "native_execution": "NOT_RUN",
  "date_table": "Mark Calendar.Date as the date table.",
  "sorting": "Sort Calendar.MonthLabel by Calendar.PeriodKey.",
  "security": "Full-Zava analyst only; no native RLS, CLS or OLS claim. No restricted-role fixtures."
}
